{
  "name": "slack-bot",
  "version": "0.0.1",
  "private": true,
  "description": "Slack-fronted agent on the pi-durable harness: Jira, GitHub, and GitLab through threads",
  "type": "module",
  "scripts": {
    "dev": "node src/index.ts",
    "start": "node src/index.ts",
    "lint": "oxlint --deny-warnings --type-aware --type-check",
    "lint:fix": "oxlint --fix --deny-warnings --type-aware --type-check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-codemode": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "@slack/bolt": "^5.1.0",
    "dotenv": "^18.0.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@slack/types": "^3.2.0",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "vitest": "^5.0.5"
  }
}
