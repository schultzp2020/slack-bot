# Secrets only — settings live in config.yaml
# Slack app: OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Slack app: Basic Information -> App-Level Tokens (connections:write)
SLACK_APP_TOKEN=xapp-...
# OpenAI-compatible model gateway (overrides config.yaml model.base_url)
# MODEL_BASE_URL=https://your-gateway.example.com/v1
MODEL_API_KEY=...

# Optional env overrides for config.yaml values:
# MODEL_ID=your-model-id
# WARDEN_BACKEND=llama-cpp
# WARDEN_URL=http://127.0.0.1:18080
# WARDEN_MODEL=ggml-org/vllm-d3-flash-GGUF:Q8_0
# WARDEN_HOLD_SCORE=0.9
# WARDEN_INJECTION_SCORE=0.75
# CODEMODE_MEMORY_MB=64

# API key for remote warden backends (openai, jev); llama-cpp needs none.
# WARDEN_API_KEY=...
